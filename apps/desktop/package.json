    "@deepseek-ai/dsh-workflow": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.dsh",
    "productName": "DeepSeek Harness",
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "en",
      "zh-CN"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "lib/main.js",
      "lib/preload.cjs",
      "ui/**/*",
      "build/icon.png",
      "build/trayTemplate*.png",
      "package.json",
      "!**/node-pty/build{,/**}"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node-pty/**",
      "**/@vscode/ripgrep-*/bin/**",
      "**/@deepseek-ai/node-addon-landlock-run-*/bin/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "msi"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
