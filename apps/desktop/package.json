{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "DeepSeek Harness Electron application with an embedded Cordis Host",
  "version": "0.1.0-rc.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "license": "MIT",
  "scripts": {
    "build:code": "tsc -b tsconfig.json && tsdown",
    "dev": "pnpm --dir ../.. run build && pnpm run build:code && pnpm --dir ../.. exec tsx scripts/dev-desktop.ts",
    "build": "pnpm --dir ../.. run build && pnpm run build:code && electron-builder",
    "pack": "pnpm --dir ../.. run build && pnpm run build:code && electron-builder --dir"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
